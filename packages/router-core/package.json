{
  "name": "@zby/router-core",
  "version": "0.1.0",
  "description": "Routing, tabs, keep-alive and persistence core for ZBY digital platforms.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.mts",
      "import": "./dist/react-router/index.mjs",
      "require": "./dist/react-router/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/index.en-US.md",
    "src/index.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "zustand": "5.0.12"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  }
}
