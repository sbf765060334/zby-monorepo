{
  "name": "@zby/intl",
  "version": "0.1.0",
  "description": "Shared internationalization utilities for ZBY React packages.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "^15.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}