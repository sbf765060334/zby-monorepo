{
  "name": "@zby/ui",
  "version": "0.1.0",
  "description": "Ant Design v6 based supplemental UI components for ZBY React applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.mts",
      "import": "./dist/locales/index.mjs",
      "require": "./dist/locales/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ant-design/fast-color": "3.0.1",
    "@ant-design/icons": "6.3.2",
    "@rc-component/context": "2.0.2",
    "@rc-component/table": "1.10.4",
    "@rc-component/tree": "1.3.2",
    "@rc-component/util": "1.12.0",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@zby/intl": "workspace:*",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": ">=1.0.0",
    "antd": "^6.5.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
