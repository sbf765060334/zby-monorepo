{
  "name": "@zby/ui",
  "version": "0.2.1",
  "description": "Ant Design v6 based supplemental UI components for ZBY React applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./locale/zh_CN": {
      "types": "./dist/locale/zh_CN.d.mts",
      "import": "./dist/locale/zh_CN.mjs",
      "require": "./dist/locale/zh_CN.cjs"
    },
    "./locale/en_US": {
      "types": "./dist/locale/en_US.d.mts",
      "import": "./dist/locale/en_US.mjs",
      "require": "./dist/locale/en_US.cjs"
    },
    "./locale/vi_VN": {
      "types": "./dist/locale/vi_VN.d.mts",
      "import": "./dist/locale/vi_VN.mjs",
      "require": "./dist/locale/vi_VN.cjs"
    },
    "./locale/my_MM": {
      "types": "./dist/locale/my_MM.d.mts",
      "import": "./dist/locale/my_MM.mjs",
      "require": "./dist/locale/my_MM.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsc -b src/components/table/rc-table.tsconfig.json",
    "typecheck": "tsc -b src/components/table/rc-table.tsconfig.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ant-design/fast-color": "3.0.1",
    "@ant-design/icons": "6.3.4",
    "@rc-component/context": "2.0.2",
    "@rc-component/resize-observer": "1.1.2",
    "@rc-component/tree": "1.3.2",
    "@rc-component/util": "1.12.0",
    "@rc-component/virtual-list": "1.2.0",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@zby/intl": "workspace:*",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": ">=1.0.0",
    "antd": "^6.6.4",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
