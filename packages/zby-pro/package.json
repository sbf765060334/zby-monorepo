{
  "name": "@zby/pro",
  "version": "0.1.0",
  "description": "Higher-level business components for ZBY React applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./locale/zh_CN": {
      "types": "./dist/locale/zh_CN.d.mts",
      "import": "./dist/locale/zh_CN.mjs",
      "require": "./dist/locale/zh_CN.cjs"
    },
    "./locale/en_US": {
      "types": "./dist/locale/en_US.d.mts",
      "import": "./dist/locale/en_US.mjs",
      "require": "./dist/locale/en_US.cjs"
    },
    "./pro-layout": {
      "types": "./dist/pro-layout/index.d.mts",
      "import": "./dist/pro-layout/index.mjs",
      "require": "./dist/pro-layout/index.cjs"
    },
    "./pro-modal": {
      "types": "./dist/pro-modal/index.d.mts",
      "import": "./dist/pro-modal/index.mjs",
      "require": "./dist/pro-modal/index.cjs"
    },
    "./pro-sortable-list": {
      "types": "./dist/pro-sortable-list/index.d.mts",
      "import": "./dist/pro-sortable-list/index.mjs",
      "require": "./dist/pro-sortable-list/index.cjs"
    },
    "./pro-view-management": {
      "types": "./dist/pro-view-management/index.d.mts",
      "import": "./dist/pro-view-management/index.mjs",
      "require": "./dist/pro-view-management/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rc-component/util": "1.12.0",
    "@zby/hooks": "workspace:*",
    "@zby/intl": "workspace:*",
    "@zby/router-core": "workspace:*",
    "@zby/ui": "workspace:*",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "cmdk": "1.1.1",
    "idb-keyval": "6.3.0",
    "nprogress": "0.2.0",
    "react-error-boundary": "6.1.2",
    "react-hotkeys-hook": "5.3.3",
    "zustand": "5.0.12"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": ">=1.0.0",
    "antd": "^6.6.4",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "devDependencies": {
    "@types/nprogress": "0.2.3"
  }
}
